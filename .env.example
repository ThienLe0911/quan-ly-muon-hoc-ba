# Kết nối cơ sở dữ liệu Turso (libSQL) khi triển khai lên Vercel
# Ví dụ trên Vercel:
# TURSO_DATABASE_URL=libsql://quan-ly-hoc-ba-<org>.turso.io
# TURSO_AUTH_TOKEN=<token-turso-cua-ban>
# Khi phát triển cục bộ (để file SQLite nội bộ chạy offline, không cần token):
TURSO_DATABASE_URL=file:./data/app.db
TURSO_AUTH_TOKEN=

# Múi giờ nghiệp vụ chuẩn (Việt Nam)
TZ=Asia/Ho_Chi_Minh

# Tự động là true khi chạy trên Vercel (VERCEL=1); để false khi chạy HTTP trên localhost
AUTH_COOKIE_SECURE=false

# Tự động là true khi chạy trên Vercel (VERCEL=1) để đọc X-Forwarded-For từ edge proxy
TRUST_PROXY=false

# Thời hạn phiên đăng nhập (ngày)
SESSION_TTL_DAYS=7

# Thông tin khởi tạo tài khoản Admin đầu tiên (chỉ chạy nếu DB chưa có Admin nào)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Giáo vụ nhà trường
SEED_ADMIN_MUST_CHANGE_PASSWORD=false
